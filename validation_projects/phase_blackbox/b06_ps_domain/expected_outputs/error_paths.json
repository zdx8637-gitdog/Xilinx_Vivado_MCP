{
  "scenario": "error_paths",
  "assertions": [
    {"id": "no_session_error", "field": "ps_connect_hw_server", "expect": true,
     "note": "Calling a ps_* tool with no active session returns an error envelope."},
    {"id": "no_session_code", "field": "error.code", "expect": "LOCK_BUSY"},
    {"id": "no_session_reason", "field": "error.details.reason_code", "expect": "NO_ACTIVE_SESSION"},
    {"id": "session_created", "field": "create_session", "expect": true},
    {"id": "empty_sid_error", "field": "ps_connect_hw_server", "expect": true,
     "note": "Empty session_id is rejected by the dispatcher before admission."},
    {"id": "empty_sid_code", "field": "error.code", "expect": "INVALID_ARGUMENT"},
    {"id": "empty_sid_reason", "field": "error.details.reason_code", "expect": "SESSION_ID_REQUIRED"},
    {"id": "nonstr_sid_error", "field": "ps_connect_hw_server", "expect": true,
     "note": "Non-string session_id (int) is rejected."},
    {"id": "nonstr_sid_reason", "field": "error.details.reason_code", "expect": "SESSION_ID_REQUIRED"},
    {"id": "mismatch_sid_error", "field": "ps_connect_hw_server", "expect": true},
    {"id": "mismatch_sid_reason", "field": "error.details.reason_code", "expect": "SESSION_ID_MISMATCH"},
    {"id": "schema_rejected", "field": "ps_select_target", "expect": true,
     "note": "Missing required param target_id is rejected by the MCP input schema (isError)."},
    {"id": "schema_rejected_message", "field": "ps_select_target", "expect": true,
     "note": "Rejection text names 'target_id' as a required property."},
    {"id": "wrong_stage_error", "field": "pl_generate_system_top", "expect": true,
     "note": "Stage-gated tool at PLATFORM_DESIGN is rejected by the shared P7 stage gate; PS tools are stage-agnostic (next_stage=None), this proves the shared gate."},
    {"id": "wrong_stage_code", "field": "error.code", "expect": "LOCK_BUSY"},
    {"id": "wrong_stage_reason", "field": "error.details.reason_code", "expect": "STAGE_PREREQUISITE_UNMET"},
    {"id": "invalid_xsa_error", "field": "ps_import_hardware", "expect": true,
     "note": "Nonexistent XSA path fails the operation (no false success)."},
    {"id": "invalid_xsa_reason", "field": "ps_import_hardware", "expect_one_of": ["XSA_NOT_FOUND", "BRIDGE_NOT_READY"],
     "note": "XSA_NOT_FOUND when the XSCT bridge is ready; BRIDGE_NOT_READY when xsct is unavailable (fail-closed)."},
    {"id": "channel_clean", "field": "get_execution_state", "expect": "IDLE",
     "note": "Error paths must not corrupt the channel (lane returns to IDLE)."},
    {"id": "close_session_ok", "field": "close_session", "expect": true}
  ]
}
