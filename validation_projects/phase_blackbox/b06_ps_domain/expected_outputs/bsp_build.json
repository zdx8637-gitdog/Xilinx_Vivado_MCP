{
  "scenario": "bsp_build",
  "assertions": [
    {"id": "session_created", "field": "create_session", "expect": true},
    {"id": "session_id", "field": "create_session", "expect_pattern": "^session-[0-9a-f]{32}$"},
    {"id": "project_path_valid", "field": "create_session", "expect": true},
    {"id": "initial_stage", "field": "get_execution_state", "expect": "PLATFORM_DESIGN"},
    {"id": "import_succeeded", "field": "ps_import_hardware", "expect": true},
    {"id": "import_workspace_xsa", "field": "ps_import_hardware", "expect_contains": "ax7020_base.xsa",
     "note": "ps_import_hardware copies the XSA into the XSCT workspace."},
    {"id": "platform_created", "field": "ps_create_platform", "expect": true},
    {"id": "platform_cpu", "field": "ps_create_platform", "expect": "ps7_cortexa9_0"},
    {"id": "platform_os", "field": "ps_create_platform", "expect": "standalone"},
    {"id": "bsp_generated", "field": "ps_create_bsp", "expect": true,
     "note": "Vitis 2023.1 materializes the BSP/FSBL via `platform generate`."},
    {"id": "app_created", "field": "ps_create_app", "expect": true},
    {"id": "app_name", "field": "ps_create_app", "expect": "ps_led_test"},
    {"id": "sources_added", "field": "ps_add_sources", "expect": true},
    {"id": "sources_app", "field": "ps_add_sources", "expect": "ps_led_test"},
    {"id": "options_configured", "field": "ps_set_compiler_options", "expect": true},
    {"id": "compile_succeeded", "field": "ps_compile", "expect": true},
    {"id": "build_status_count_min", "field": "ps_get_build_status", "expect_min": 1},
    {"id": "app_built", "field": "ps_get_build_status", "expect": true},
    {"id": "elf_path_present", "field": "ps_get_build_status", "expect": true,
     "note": "Build status must report a built ELF path for the app."},
    {"id": "elf_exists", "field": "artifact", "expect": true,
     "note": "The reported ELF must exist on disk."},
    {"id": "elf_magic_valid", "field": "ps_read_elf_info", "expect": true},
    {"id": "elf_class", "field": "ps_read_elf_info", "expect": "ELFCLASS32"},
    {"id": "elf_machine", "field": "ps_read_elf_info", "expect": 40,
     "note": "e_machine 40 = EM_ARM (Cortex-A9 is 32-bit ARM)."},
    {"id": "close_session_ok", "field": "close_session", "expect": true},
    {"id": "final_lane", "field": "get_execution_state", "expect": "IDLE"}
  ]
}
