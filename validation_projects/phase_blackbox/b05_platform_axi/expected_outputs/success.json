{
  "scenario": "success",
  "assertions": [
    {"id": "session_created", "field": "create_session", "expect": true},
    {"id": "session_id", "field": "create_session", "expect_pattern": "^session-[0-9a-f]{32}$"},
    {"id": "initial_stage", "field": "get_execution_state", "expect": "PLATFORM_DESIGN"},
    {"id": "admission_ok", "field": "platform_generate", "expect": true},
    {"id": "op_id", "field": "platform_generate", "expect_pattern": "^op-[0-9a-f]{32}$"},
    {"id": "terminal_succeeded", "field": "wait_operation", "expect": true},
    {"id": "stage_from", "field": "completion_evidence", "expect": "PLATFORM_DESIGN"},
    {"id": "stage_to", "field": "completion_evidence", "expect": "PL_GENERATE"},
    {"id": "final_stage", "field": "get_execution_state", "expect": "PL_GENERATE"},
    {"id": "final_lane", "field": "get_execution_state", "expect": "IDLE"},
    {"id": "platform_revision", "field": "get_session_info", "expect_check_sha": true},
    {"id": "platform_revision_format", "field": "get_session_info", "expect": true},
    {"id": "output_artifact_revision", "field": "get_operation_status", "expect_check_sha": true},
    {"id": "op_rev_matches_ctx", "field": "cross_check", "expect": true},
    {"id": "xsa_exists", "field": "artifact", "expect": true},
    {"id": "wrapper_exists", "field": "artifact", "expect": true},
    {"id": "manifest_exists", "field": "artifact", "expect": true},
    {"id": "xsa_disk_matches_op", "field": "artifact.sha", "expect": true},
    {"id": "wrapper_disk_matches_op", "field": "artifact.sha", "expect": true},
    {"id": "manifest_disk_matches_op", "field": "artifact.sha", "expect": true},
    {"id": "manifest_schema", "field": "manifest", "expect": "1.0"},
    {"id": "manifest_type", "field": "manifest", "expect": "platform"},
    {"id": "manifest_status", "field": "manifest", "expect": "locked"},
    {"id": "manifest_rev_match", "field": "manifest", "expect": true},
    {"id": "manifest_xsa_disk_match", "field": "manifest.sha", "expect": true},
    {"id": "manifest_wrapper_disk_match", "field": "manifest.sha", "expect": true},
    {"id": "manifest_rev_ctx_match", "field": "context", "expect": true},
    {"id": "manifest_addr_base", "field": "manifest.address_map", "expect": "0x41200000"},
    {"id": "manifest_addr_range", "field": "manifest.address_map", "expect": "64K"},
    {"id": "pl_handoff_ok", "field": "pl_generate_system_top", "expect": true},
    {"id": "pl_handoff_succeeded", "field": "wait_operation", "expect": true}
  ]
}
